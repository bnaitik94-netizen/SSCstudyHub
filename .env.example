# ===================================================================
# SSC STUDY HUB ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file to .env and fill in your actual private credentials.
# ===================================================================

# -------------------------------------------------------------------
# 🤖 Google Gemini AI Service
# -------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------
# 🔥 Firebase Project Credentials
# -------------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_APP_ID_WEB=your_web_app_id
FIREBASE_APP_ID_ANDROID=your_android_app_id

# -------------------------------------------------------------------
# 🐙 GitHub Integration (Syllabus & Quiz Sync)
# -------------------------------------------------------------------
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_github_repo_name
GITHUB_PAT_TOKEN=your_personal_access_token_here

# -------------------------------------------------------------------
# 🔒 Admin Studio & Credentials
# -------------------------------------------------------------------
ADMIN_PASSWORD=your_admin_password_here
ADMIN_AUTH_HASH=your_sha256_hash_here
ADMIN_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
